# ======================================================
# Finance Credit Follow-Up Email Agent - Environment Variables
# ======================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.

# Anthropic API Key (required for real LLM mode)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# SMTP Configuration (required for send mode)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SENDER_EMAIL=finance@yourcompany.com

# Agent Mode: dry_run (default) or send
MODE=dry_run
